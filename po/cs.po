#: data/appdata/org.gnome.Notes.metainfo.xml.in:6
#: data/org.gnome.Notes.desktop.in:2 data/org.gnome.Notes.xml.in:4
#: data/resources/bjb-window.ui:4 src/bjb-window.c:42 src/bjb-window.c:91
msgid "Notes"
msgstr "Poznámky"

#: data/appdata/org.gnome.Notes.metainfo.xml.in:7
msgid "Notes for GNOME"
msgstr "Poznámky pro GNOME"

#: data/appdata/org.gnome.Notes.metainfo.xml.in:9
msgid ""
"A quick and easy way to make freeform notes or jot down simple lists. Store "
"as many notes as you like and share them by email."
msgstr ""
"Rychlý a jednoduchý způsob, jak si zapisovat volně psané poznámky nebo "
"krátké bodové myšlenky. Zapište si tolik poznámek, kolik chcete a sdílejte "
"je přes e-mail."

#: data/appdata/org.gnome.Notes.metainfo.xml.in:12
msgid ""
"You can store your notes locally on your computer or sync with online "
"services like ownCloud."
msgstr ""
"Své poznámky si můžete uchovávat samostatně na svém počítači, nebo je "
"synchronizovat se službami on-line, jako je ownCloud."

#: data/appdata/org.gnome.Notes.metainfo.xml.in:28
msgid "Edit view"
msgstr "Ukázka úprav"

#: data/appdata/org.gnome.Notes.metainfo.xml.in:32
msgid "Select view"
msgstr "Ukázka výběru"

#: data/appdata/org.gnome.Notes.metainfo.xml.in:36
msgid "List view"
msgstr "Ukázka seznamu"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.Notes.desktop.in:4
msgid "notes;reminder;notebook;sticky notes;"
msgstr ""
"poznámky;tahák;blbníček;zapomnětníček;připomenutí;sešit;lepicí poznámky;"

#: data/org.gnome.Notes.desktop.in:5
msgid "Post notes, tag files!"
msgstr "Vylepujte si poznámky, štítkujte soubory!"

#: data/org.gnome.Notes.desktop.in:6
msgid "Note-taker"
msgstr "Poznámky"

